# Postgres connection (Supabase: Project Settings → Database → Connection string)
DATABASE_URL=

# Optional: Supabase "SSL certificate" PEM (Project Settings → Database).
# Paste the full PEM into Vercel as DATABASE_CA_CERT (Production + Preview).
# When set, Prisma/pg verifies TLS against this CA; DATABASE_URL can use plain
# ?sslmode=require without uselibpqcompat.
DATABASE_CA_CERT=