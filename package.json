{
  "name": "mashiko-pottery",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:staging": "dotenv -e .env.staging -- next dev",
    "dev:local": "dotenv -e .env.local -- next dev",
    "postinstall": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit && eslint '*/**/*.{ts,tsx}' --quiet --fix",
    "prettier-format": "prettier --config .prettierrc '*/**/*.{ts,tsx}' --write",
    "format:check": "prettier --config .prettierrc --check .",
    "dev:migrate": "prisma migrate dev --name",
    "db:push": "prisma db push",
    "db:push:local": "dotenv -e .env.local -- prisma db push",
    "migrate:staging": "dotenv -e .env.staging -- npx prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset"
  },
